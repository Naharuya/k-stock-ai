{
  "name": "k-stock-ai",
  "version": "2.6.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "smoke": "node src/smoke_test.js",
    "dart:check": "node src/dart_smoke_test.js",
    "dart:analyze": "node src/dart_analysis_smoke_test.js",
    "score:check": "node src/scoring_smoke_test.js",
    "kis:check": "node src/kis_quote_smoke_test.js",
    "market:analyze": "node src/market_analysis_smoke_test.js",
    "flow:check": "node src/flow_smoke_test.js",
    "market:check": "node src/market_context_smoke_test.js",
    "news:check": "node src/news_smoke_test.js",
    "committee:check": "node src/committee_smoke_test.js",
    "research:check": "node src/research_profile_smoke_test.js",
    "screener:check": "node src/screener_smoke_test.js",
    "universe:check": "node src/universe_live_smoke_test.js",
    "screener:live": "node src/screener_live_smoke_test.js",
    "candidate:check": "node src/candidate_engine_smoke_test.js",
    "candidate:live": "node src/candidate_engine_live_smoke_test.js",
    "candidate:balanced": "node src/candidate_engine_balanced_smoke_test.js",
    "risk:semantic": "node src/disclosure_semantic_smoke_test.js",
    "dashboard:check": "node src/dashboard_operational_smoke_test.js",
    "candidate:rank": "node src/candidate_ranking_smoke_test.js",
    "entry-exit:check": "node src/entry_exit_smoke_test.js",
    "entry-exit-ux:check": "node src/entry_exit_ux_smoke_test.js",
    "entry-exit:ux": "node src/entry_exit_ux_smoke_test.js",
    "daily:check": "node src/daily_smoke_test.js && node src/daily_scheduler_smoke_test.js && node src/daily_api_smoke_test.js && node src/daily_dashboard_smoke_test.js",
    "daily:store-check": "node src/daily_store_smoke_test.js",
    "daily:after-market": "node src/daily_cli.js after-market",
    "daily:pre-market": "node src/daily_cli.js pre-market",
    "portfolio:check": "node src/portfolio_concurrency_smoke_test.js",
    "daily:browser-check": "node src/daily_browser_smoke_test.js",
    "calendar:check": "node src/trading_calendar_smoke_test.js",
    "daily-agents:check": "node src/daily_agents_smoke_test.js && node src/morning_scheduler_smoke_test.js && node src/kis_rate_limit_smoke_test.js",
    "daily-agents:run": "node src/daily_agents_cli.js run",
    "daily-agents:status": "node src/daily_agents_cli.js status",
    "daily-agents:browser-check": "node src/morning_browser_smoke_test.js",
    "daily-agents:live-check": "node src/daily_agents_live_smoke_test.js",
    "mobile:check": "node src/mobile_ui_smoke_test.js",
    "android:build": "powershell -NoProfile -File android/build.ps1",
    "calendar:sync": "node src/calendar_sync_cli.js",
    "reliability:check": "node src/reliability_smoke_test.js",
    "reliability:live": "node src/reliability_live_check.js",
    "operations:start": "node src/server_supervisor.js",
    "operations:install": "powershell -NoProfile -File scripts/install_startup.ps1",
    "news:evidence-check": "node src/news_evidence_smoke_test.js",
    "server:check": "node src/server_smoke_test.js",
    "mobile-api:check": "node src/mobile_api_smoke_test.js && node src/mobile_address_smoke_test.js",
    "operations:morning-check": "node scripts/operations_morning_check.mjs",
    "ai:check": "node src/ollama_smoke_test.js"
  },
  "dependencies": {
    "adm-zip": "latest",
    "dotenv": "latest",
    "express": "latest",
    "fast-xml-parser": "latest",
    "openai": "latest"
  }
}
