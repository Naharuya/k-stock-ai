PORT=3000

# mock: 고정 결과로 전체 흐름 테스트
# local: Mac Ollama 로컬 모델 사용
# openai: OpenAI Responses API 사용
KSTOCK_AI_MODE=mock
KSTOCK_LOCAL_BASE_URL=http://127.0.0.1:11434
KSTOCK_LOCAL_MODEL=qwen3:8b
KSTOCK_LOCAL_TIMEOUT_MS=120000
KSTOCK_LOCAL_LONG_TIMEOUT_MS=300000
KSTOCK_LOCAL_MAX_OUTPUT_TOKENS=512
KSTOCK_LOCAL_LONG_OUTPUT_TOKENS=2048

OPENAI_API_KEY=
KSTOCK_DEFAULT_MODEL=gpt-5.5

# OpenDART 실데이터는 명시적으로 활성화하고 API 키를 설정해야 사용됩니다.
KSTOCK_DART_ENABLED=false
OPENDART_API_KEY=
KSTOCK_KIS_ENABLED=false
KIS_ENV=paper
KIS_APP_KEY=
KIS_APP_SECRET=
KSTOCK_BROKER_ENABLED=false
KSTOCK_NEWS_ENABLED=false

# 1단계에서는 반드시 false 유지
KSTOCK_LIVE_TRADING_ENABLED=false


# External HTTPS access (disabled by default)
# Keep false on a local-only Mac mini.
KSTOCK_EXTERNAL_ACCESS_ENABLED=false
KSTOCK_EXTERNAL_ACCESS_TOKEN=

# For a reverse proxy on the same host, keep HOST=127.0.0.1.
# Set HOST=0.0.0.0 only when an authenticated private/LAN ingress explicitly requires it.
HOST=127.0.0.1
