PORT=3000

KSTOCK_AI_MODE=mock
OPENAI_API_KEY=
KSTOCK_DEFAULT_MODEL=gpt-5.5

# OpenDART
KSTOCK_DART_ENABLED=true
DART_API_KEY=
DART_CORP_CODE_CACHE_HOURS=24

# KIS Open API
KSTOCK_BROKER_ENABLED=false
KIS_ENV=prod
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_TOKEN_SAFETY_SECONDS=120

# KIS 안정화: 호출 직렬화/속도제한/재시도
KIS_API_MIN_INTERVAL_MS=1200
KIS_RATE_LIMIT_MAX_RETRIES=2
KIS_RATE_LIMIT_RETRY_MS=61000

KSTOCK_NEWS_ENABLED=true

# 실제 주문은 미구현. 반드시 false 유지
KSTOCK_LIVE_TRADING_ENABLED=false

# News Agent v0.7.0 (별도 API 키 불필요: Google News RSS)
KSTOCK_NEWS_PROVIDER=google_rss
KSTOCK_NEWS_LOOKBACK_DAYS=7
KSTOCK_NEWS_MAX_ITEMS=30
