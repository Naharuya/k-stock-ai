PORT=3000

KSTOCK_AI_MODE=mock
# Windows: SSH tunnel to Mac mini; on Mac use http://127.0.0.1:11434
KSTOCK_OLLAMA_BASE_URL=http://127.0.0.1:11435
KSTOCK_AI_TIMEOUT_MS=120000
KSTOCK_DEFAULT_MODEL=qwen3.5:4b-mlx

# OpenDART
KSTOCK_DART_ENABLED=true
DART_API_KEY=
DART_CORP_CODE_CACHE_HOURS=24

# KIS Open API
KSTOCK_BROKER_ENABLED=false
KIS_ENV=prod
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_TOKEN_SAFETY_SECONDS=120

# KIS 안정화: 호출 직렬화/속도제한/재시도
KIS_API_MIN_INTERVAL_MS=1200
KIS_RATE_LIMIT_MAX_RETRIES=2
KIS_RATE_LIMIT_RETRY_MS=61000

KSTOCK_NEWS_ENABLED=true

# 실제 주문은 미구현. 반드시 false 유지
KSTOCK_LIVE_TRADING_ENABLED=false

# News Agent v0.7.0 (별도 API 키 불필요: Google News RSS)
KSTOCK_NEWS_PROVIDER=google_rss
KSTOCK_NEWS_LOOKBACK_DAYS=7
KSTOCK_NEWS_MAX_ITEMS=30

# Daily Trading Agent (Asia/Seoul; automatic execution is OFF by default)
KSTOCK_DAILY_AGENT_ENABLED=false
KSTOCK_AFTER_MARKET_HOUR=15
KSTOCK_AFTER_MARKET_MINUTE=40
KSTOCK_PRE_MARKET_HOUR=8
KSTOCK_PRE_MARKET_MINUTE=30

# Offline closures: comma-separated YYYY-MM-DD dates; restart after editing.
# Empty means weekends only. Use verified dates before operation.
KSTOCK_MARKET_CLOSED_DATES=

# 07:00 research orchestrator (server must remain running)
KSTOCK_DAILY_ORCHESTRATOR_ENABLED=false
KSTOCK_DAILY_ORCHESTRATOR_HOUR=7
KSTOCK_DAILY_ORCHESTRATOR_MINUTE=0
KSTOCK_TIMEZONE=Asia/Seoul

# v2.6.3: device pairing, isolated server profile and optional direct TLS
KSTOCK_PROFILE=local-owner
KSTOCK_PROVIDER_TIMEOUT_MS=30000
# KSTOCK_TLS_CERT=C:/certs/fullchain.pem
# KSTOCK_TLS_KEY=C:/certs/privkey.pem
# KSTOCK_CALENDAR_FILE=.data/calendar/krx.json

# Optional calendar synchronization; disable only for isolated/offline tests.
KSTOCK_CALENDAR_SYNC_ENABLED=true
